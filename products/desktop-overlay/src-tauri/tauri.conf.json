{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Traffic Lights",
  "version": "0.1.1",
  "identifier": "com.jikersun.ai-traffic-lights",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "AI Traffic Lights",
        "url": "overlay.html",
        "width": 62,
        "height": 162,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "focus": false
      },
      {
        "label": "setup",
        "title": "AI Traffic Lights — Setup",
        "url": "setup.html",
        "width": 440,
        "height": 560,
        "center": true,
        "visible": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      },
      {
        "label": "settings",
        "title": "AI Traffic Lights",
        "url": "settings.html",
        "width": 440,
        "height": 720,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/hook-kit/": "hook-kit/"
    }
  },
  "plugins": {}
}
